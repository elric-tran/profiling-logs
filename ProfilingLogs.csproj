<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <PackageId>ProfilingLogs</PackageId>
    <Version>1.0.3</Version>
    <Authors>Elric</Authors>
    <Description>Standalone SQL profiling for ASP.NET Core: per-connection color markers, caller source-line comments injected into SQL, and clickable IDE deep-links (VSCode/Cursor/Rider) with a built-in React UI. Production-safe: everything is a no-op unless Enabled is set.</Description>
    <PackageTags>profiling;sql;efcore;logging;diagnostics</PackageTags>
    <RepositoryUrl>https://github.com/elric-tran/profiling-logs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\profilinglogs-ui.js" LogicalName="profilinglogs-ui.js" />
  </ItemGroup>

  <!-- Only run frontend build for the first TFM to avoid parallel EPERM conflicts -->
  <Target Name="BuildFrontend" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(TargetFramework)' == 'net8.0'">
    <PropertyGroup>
      <FrontendDir>$(MSBuildProjectDirectory)\frontend</FrontendDir>
      <FrontendDist>$(FrontendDir)\dist</FrontendDist>
      <WwwRoot>$(MSBuildProjectDirectory)\wwwroot</WwwRoot>
    </PropertyGroup>
    <Message Text="Building frontend: $(FrontendDir)" Importance="high" />
    <Exec WorkingDirectory="$(FrontendDir)" Command="npm install" ContinueOnError="false" />
    <Exec WorkingDirectory="$(FrontendDir)" Command="npm run build" ContinueOnError="false" />
    <RemoveDir Directories="$(WwwRoot)" ContinueOnError="true" />
    <MakeDir Directories="$(WwwRoot)" />
    <ItemGroup>
      <BuiltFiles Include="$(FrontendDist)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltFiles)" DestinationFiles="@(BuiltFiles->'$(WwwRoot)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
